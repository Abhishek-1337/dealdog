# psycopg2-binary is the driver in pyproject.toml, so use the bare
# `postgresql://` scheme (or `postgresql+psycopg2://`). `postgresql+psycopg://`
# selects psycopg 3, which is not installed, and fails at startup.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
MATCH_THRESHOLD=0.90
PENDING_LOW=0.80
TOP_K=5
